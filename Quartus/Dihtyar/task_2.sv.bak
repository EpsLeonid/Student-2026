// ==========================================
// Пункт 2: умножение сигналов 
// ========================================== 
module task_2 (
    // Входные порты (сигналы, которые приходят в модуль)
    input  logic [7:0] A, // 8-битный входной сигнал A (биты от 7 до 0)
    input  logic [7:0] B, // 8-битный входной сигнал B

    // Выходной порт (результат работы модуля)
    // При умножении двух 8-битных чисел результат может быть до 16 бит (8 + 8),
    // чтобы не произошло потери данных (переполнения).
    output logic [15:0] C 
);

    // Комбинационная логика. 
    // Ключевое слово 'assign' связывает формулу с выходом напрямую.
    // Как только меняется A или B, значение C мгновенно пересчитывается.
    assign C = A * B;

endmodule

// ==========================================
// Пункт 3: D-триггер
// ==========================================
module d_flop (
    input  logic clk, // Тактовый сигнал (частота)
    input  logic d,   // Вход данных
    output logic out  // Выход данных
);

    always_ff @(posedge clk) begin
        out <= d; 
    end

endmodule

// ==========================================
// Пункт 4: 8-разрядный регистр с вычислением
// ==========================================
module reg_calc_8bit (
    input  logic clk,            // Тактовый сигнал 200 МГц
    input  logic [7:0] A,        // 8-битный вход A
    input  logic [7:0] B,        // 8-битный вход B
    input  logic [7:0] C,        // 8-битный вход C
    output logic [7:0] DATA_OUT  // 8-битный выход регистра
);

    // Так как это регистр (память), мы снова используем always_ff по фронту clk.
    // Физическая частота (200 МГц) задается внешним генератором на плате, 
    // в самом коде мы просто привязываемся к фронту этого сигнала.
    always_ff @(posedge clk) begin
        DATA_OUT <= A * B + C;
    end

endmodule

// ==========================================
// Пункт 5: Параметризованный модуль регистра
// ==========================================
// Подключаем файл параметров, чтобы модуль видел константы
`include "params.svh"

module reg_calc_param (
    input  logic                    clk,      // Тактовый сигнал
    input  logic [INPUT_WIDTH-1:0]  A,        // Вход A (8 бит, так как 8-1=7)
    input  logic [INPUT_WIDTH-1:0]  B,        // Вход B (8 бит)
    input  logic [INPUT_WIDTH-1:0]  C,        // Вход C (8 бит)
    output logic [OUTPUT_WIDTH-1:0] DATA_OUT  // Выход регистра (16 бит без переполнения!)
);

    always_ff @(posedge clk) begin
        DATA_OUT <= A * B + C;
    end

endmodule

